# Copy to .env and fill in local values: cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# These variables are used by docker-compose and services from Phase 3 onward.

# --- PostgreSQL (Phase 3) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
USER_DB_PASSWORD=change-me
ACCOUNT_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
TRANSACTION_DB_PASSWORD=change-me

# --- Keycloak (Phase 4) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Service client secrets for Client Credentials flow (Phase 10) ---
PAYMENT_SERVICE_CLIENT_SECRET=change-me
