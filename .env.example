# Copy to .env and fill in local values: cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# These variables are used by docker-compose and services from Phase 3 onward.

# --- PostgreSQL (Phase 3) ---
# Host port for the Postgres container (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me
USER_DB_PASSWORD=change-me
ACCOUNT_DB_PASSWORD=change-me
PAYMENT_DB_PASSWORD=change-me
TRANSACTION_DB_PASSWORD=change-me

# --- Keycloak (Phase 4) ---
# Bootstrap admin for the Keycloak admin console (http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
# Password of Keycloak's own database role (keycloak_svc)
KEYCLOAK_DB_PASSWORD=change-me
# Password shared by the demo users alice, bob, sam, ada (local dev only)
DEMO_USER_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me

# --- Service client secrets for Client Credentials flow (Phase 10) ---
PAYMENT_SERVICE_CLIENT_SECRET=change-me

# --- Grafana (Phase 14) ---
# Admin login for http://localhost:3000 (user: admin)
GRAFANA_ADMIN_PASSWORD=change-me
