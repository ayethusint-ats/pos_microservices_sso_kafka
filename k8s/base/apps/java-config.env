# Phase 16: settings shared by the six Spring Boot services (non-secret; secrets are files from a Secret).
# Same variables as Compose's x-java-env; only the host names change to Kubernetes Service DNS names.
# Becomes the ConfigMap banking-java-config-<hash>: editing this file rolls all six Deployments.
SPRING_PROFILES_ACTIVE=json-logs
DB_HOST=postgres.banking-infra.svc.cluster.local
DB_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=kafka.banking-infra.svc.cluster.local:9092
# Issuer = what is IN the token (the URL the browser uses); keys are fetched over the cluster network.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/banking
KEYCLOAK_JWK_SET_URI=http://keycloak.banking-infra.svc.cluster.local:8180/realms/banking/protocol/openid-connect/certs
OTLP_TRACING_ENDPOINT=http://jaeger.banking-monitoring.svc.cluster.local:4318/v1/traces
# Connection budget. Found live: every pod holds its FULL Hikari pool (minimum-idle = maximum by
# default). 12 pods × 10 during a rollout storm > Postgres's max_connections (100) → new pods died with
# "remaining connection slots are reserved". Per pod 5; worst case (HPA max + rollout surge) ≈ 14 pods
# × 5 = 70, + Keycloak 10 = 80 < 100. More replicas → recompute, or put PgBouncer in front.
SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
